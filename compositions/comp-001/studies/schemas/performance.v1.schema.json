{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "amps.performance.v1.schema.json",
  "title": "amps.performance.v1",
  "type": "object",
  "required": [
    "record_id",
    "composition_id",
    "span",
    "timebase",
    "performer_states"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "composition_id": {
      "type": "string",
      "minLength": 1
    },
    "span": {
      "type": "object",
      "dependentRequired": {"source_sha256": ["clock_kind", "timebase"], "clock_kind": ["source_sha256", "timebase"]},
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "clock_kind": {"enum": ["video_frame", "audio_sample"]},
        "timebase": {"$ref": "#/properties/timebase"},
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "timebase": {
      "type": "object",
      "required": [
        "num"
      ],
      "properties": {
        "num": {
          "type": "integer",
          "minimum": 1
        },
        "den": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "performer_states": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "timestamp": {
      "type": "string"
    },
    "provenance": {
      "type": "object"
    },
    "runtime": {
      "type": "object",
      "required": ["schema", "seed", "duration_frames", "engine_sha256", "rules_sha256", "corpus_sha256", "profile", "materials", "reference", "fallback_material_id", "events", "initial_state"],
      "properties": {
        "schema": {"const": "amps.performance-runtime.v1"},
        "seed": {"type": "integer", "minimum": 0},
        "duration_frames": {"type": "integer", "minimum": 1},
        "engine_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "rules_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "profile": {"type": "object"},
        "materials": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "reference": {"type": "object"},
        "fallback_material_id": {"type": "string", "minLength": 1},
        "events": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "initial_state": {"type": "object"}
      }
    }
  },
  "additionalProperties": true
}
