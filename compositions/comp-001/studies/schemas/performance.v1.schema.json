{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "amps.performance.v1.schema.json",
  "title": "amps.performance.v1",
  "type": "object",
  "required": [
    "record_id",
    "composition_id",
    "span",
    "timebase",
    "performer_states"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "composition_id": {
      "type": "string",
      "minLength": 1
    },
    "span": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "timebase": {
      "type": "object",
      "required": [
        "num"
      ],
      "properties": {
        "num": {
          "type": "integer",
          "minimum": 1
        },
        "den": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "performer_states": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "timestamp": {
      "type": "string"
    },
    "provenance": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
