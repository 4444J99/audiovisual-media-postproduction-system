{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "amps.study-binding.v1.schema.json",
  "title": "amps.study-binding.v1",
  "type": "object",
  "required": [
    "operator",
    "parameters",
    "provenance",
    "status"
  ],
  "properties": {
    "operator": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "object",
      "properties": {
        "mask_coupling": {"$ref": "#/properties/mask_coupling"},
        "mask_clock_operation": {"$ref": "#/$defs/independentMaskClock"},
        "dependencies": {"$ref": "#/properties/dependencies"},
        "depends_on": {"$ref": "#/properties/dependencies"}
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "not_tested",
        "named_block",
        "admitted",
        "executed",
        "accepted",
        "rejected"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_id",
        "unit_id",
        "model_id",
        "seed"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "unit_id": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer"
        }
      }
    },
    "span": {
      "type": "object",
      "dependentRequired": {"source_sha256": ["clock_kind", "timebase"], "clock_kind": ["source_sha256", "timebase"]},
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "clock_kind": {"enum": ["video_frame", "audio_sample"]},
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "timebase": {
          "type": "object",
          "required": [
            "num"
          ],
          "properties": {
            "num": {
              "type": "integer",
              "minimum": 1
            },
            "den": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 4096,
      "items": {
        "type": "string"
      }
    },
    "depends_on": {"$ref": "#/properties/dependencies"},
    "definitions": {"type": "array", "maxItems": 4096, "items": {"$ref": "#"}},
    "mask_coupling": {
      "type": "object",
      "required": [
        "target_body",
        "on_screen",
        "mask_span"
      ],
      "properties": {
        "body_span": {"$ref": "#/$defs/boundVideoSpan"},
        "operation": {"$ref": "#/$defs/independentMaskClock"},
        "target_body": {
          "type": "string",
          "minLength": 1
        },
        "on_screen": {
          "type": "boolean"
        },
        "mask_span": {
          "$ref": "#/$defs/boundVideoSpan",
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "boundVideoSpan": {
      "$ref": "#/properties/span",
      "required": ["start", "end", "timebase", "source_sha256", "clock_kind"],
      "properties": {"clock_kind": {"const": "video_frame"}}
    },
    "independentMaskClock": {
      "type": "object",
      "required": ["operator", "reason", "mask_span", "body_span"],
      "additionalProperties": false,
      "properties": {
        "operator": {"const": "mask.independent-clock.v1"},
        "reason": {"type": "string", "pattern": "\\S", "maxLength": 2048},
        "mask_span": {"$ref": "#/$defs/boundVideoSpan"},
        "body_span": {"$ref": "#/$defs/boundVideoSpan"}
      }
    }
  },
  "additionalProperties": true
}
