{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "amps.material.v1.schema.json",
  "title": "amps.material.v1",
  "type": "object",
  "required": [
    "id",
    "sha256",
    "kind"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "audio",
        "video",
        "image",
        "sequence",
        "material",
        "font",
        "dat",
        "metadata"
      ]
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "string"
    },
    "span": {
      "type": "object",
      "dependentRequired": {"source_sha256": ["clock_kind", "timebase"], "clock_kind": ["source_sha256", "timebase"]},
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "clock_kind": {"enum": ["video_frame", "audio_sample"]},
        "timebase": {
          "type": "object", "required": ["num"],
          "properties": {"num": {"type": "integer", "minimum": 1}, "den": {"type": "integer", "minimum": 1}}
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
