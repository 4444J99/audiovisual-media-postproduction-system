{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amps:revision-proposal:1",
  "title": "Non-executable revision proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "project_id",
    "status",
    "execution_allowed",
    "creative_note",
    "intended_change",
    "targets",
    "constraints",
    "operations",
    "review"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "proposed"
    },
    "execution_allowed": {
      "const": false
    },
    "creative_note": {
      "type": "string",
      "minLength": 1
    },
    "intended_change": {
      "type": "string",
      "minLength": 1
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "accepted_by",
        "criteria"
      ],
      "properties": {
        "status": {
          "const": "pending"
        },
        "accepted_by": {
          "type": "null"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "source_status",
        "start_tick",
        "end_tick",
        "ticks_per_second"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_status": {
          "enum": [
            "unverified",
            "registered",
            "synthetic"
          ]
        },
        "start_tick": {
          "type": "integer",
          "minimum": 0
        },
        "end_tick": {
          "type": "integer",
          "minimum": 1
        },
        "ticks_per_second": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "numerator",
            "denominator"
          ],
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 1
            },
            "denominator": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "target_id",
        "depends_on",
        "implementation_status",
        "parameters"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "audio_repair",
            "dialogue_timing",
            "gesture_retime",
            "text_animation",
            "tracked_reframe",
            "detail_reconstruction",
            "region_composite",
            "sound_design"
          ]
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "implementation_status": {
          "const": "planned"
        },
        "parameters": {
          "type": "object"
        }
      }
    }
  }
}
