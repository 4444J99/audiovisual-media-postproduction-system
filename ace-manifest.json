{
  "schema_version": "1.0.0",
  "system_id": "audiovisual-composition-system",
  "repository": {
    "github_id": 1409689012,
    "full_name": "4444J99/audiovisual-media-postproduction-system"
  },
  "software": {
    "id": "audiovisual-media-postproduction-system",
    "name": "Audiovisual Media Postproduction System",
    "responsibility": "Source-addressed audio processing, spatial compositing, directed revisions, source-unit scheduling and hash-bound native execution. The amp package retains its existing public interfaces."
  },
  "capabilities": [
    {
      "id": "composition-resolution",
      "description": "Resolve explicit composition configuration independently from software identity."
    },
    {
      "id": "audio-processing",
      "description": "Create dialogue-processing candidates and expressive audio returns."
    },
    {
      "id": "region-compositing",
      "description": "Apply source-timed effects to authored spatial regions and layers."
    },
    {
      "id": "person-segmentation",
      "description": "Associate learned person-mask candidates with authored spatial regions."
    },
    {
      "id": "directed-revision",
      "description": "Render source-addressed camera, typography, retiming and attention-score edits."
    },
    {
      "id": "source-unit-scheduling",
      "description": "Assemble bounded source-unit schedules with explicit listened-review admission."
    },
    {
      "id": "native-execution",
      "description": "Verify hash-bound inputs and dispatch retained native recipe formats."
    },
    {
      "id": "audiovisual-effects",
      "description": "Evaluate typed audiovisual effect graphs and controls."
    },
    {
      "id": "room-audio-processing",
      "description": "Build, refine and stretch room-audio material from source intervals."
    },
    {
      "id": "workstation-export",
      "description": "Export editable timing and media-comparison handoffs."
    }
  ],
  "modules": [
    {
      "id": "composition-resolver",
      "path": "amp/composition.py",
      "capability_ids": [
        "composition-resolution"
      ],
      "interfaces": [
        "amp.composition.resolve_composition",
        "amp --composition / --project"
      ]
    },
    {
      "id": "dialogue-processing",
      "path": "amp/audio.py",
      "capability_ids": [
        "audio-processing"
      ],
      "interfaces": [
        "amp audio",
        "amp.audio"
      ]
    },
    {
      "id": "region-compositor",
      "path": "amp/core.py",
      "capability_ids": [
        "region-compositing"
      ],
      "interfaces": [
        "amp.core.validate",
        "amp.core.composite"
      ]
    },
    {
      "id": "source-timed-renderer",
      "path": "amp/render.py",
      "capability_ids": [
        "region-compositing"
      ],
      "interfaces": [
        "amp render",
        "amp.render.render",
        "amp.render.remix"
      ],
      "compatibility_note": "Retains historical defaults; use explicit render interval or review exported filenames. See functional-identities.md."
    },
    {
      "id": "person-mask-segmentation",
      "path": "amp/segmentation.py",
      "capability_ids": [
        "person-segmentation"
      ],
      "interfaces": [
        "amp.segmentation"
      ]
    },
    {
      "id": "directed-recipe-renderer",
      "path": "amp/direction.py",
      "capability_ids": [
        "directed-revision"
      ],
      "interfaces": [
        "python -m amp.direction",
        "amps.direction.v1"
      ]
    },
    {
      "id": "directed-revision-renderer",
      "path": "amp/revision.py",
      "capability_ids": [
        "directed-revision"
      ],
      "interfaces": [
        "amp revision",
        "amp replay",
        "amp track"
      ]
    },
    {
      "id": "source-unit-scheduler",
      "path": "amp/generation.py",
      "capability_ids": [
        "source-unit-scheduling"
      ],
      "interfaces": [
        "amp generate",
        "amp.generation.generate_schedule"
      ]
    },
    {
      "id": "source-unit-qualification",
      "path": "amp/qualification.py",
      "capability_ids": [
        "source-unit-scheduling"
      ],
      "interfaces": [
        "amp qualify",
        "amp.qualification.audit_qualification"
      ]
    },
    {
      "id": "native-execution-dispatcher",
      "path": "amp/execution.py",
      "capability_ids": [
        "native-execution"
      ],
      "interfaces": [
        "amp execute",
        "amps.execution.v1"
      ]
    },
    {
      "id": "audiovisual-effects-workbench",
      "path": "web/fx",
      "capability_ids": [
        "audiovisual-effects"
      ],
      "interfaces": [
        "fx.rack.v1"
      ]
    },
    {
      "id": "room-stretch-renderer",
